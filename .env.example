# Existing database and session authentication
DATABASE_URL=
SESSION_SECRET=
# Optional Google sign-in only (unrelated to email delivery)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank to use the request origin. Never set localhost on Vercel.
GOOGLE_REDIRECT_URI=
# Gmail SMTP: use a Google App Password, never your regular Google password
SMTP_EMAIL=
SMTP_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
APP_NAME=Technology World Support
APP_BASE_URL=http://localhost:3000
# Server-only encryption and scheduled-worker secrets
EMAIL_ENCRYPTION_KEY=
EMAIL_WORKER_SECRET=
AUTH_CHALLENGE_TTL_MINUTES=15
