# Database and existing application authentication
DATABASE_URL=
SESSION_SECRET=
# Separate Google sign-in OAuth client (openid/email/profile scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Dedicated sender OAuth client authorized with gmail.send and offline access
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
APP_NAME=Technology World Support
APP_BASE_URL=http://localhost:3000
# Generate two independent random secrets. Encryption key must decode to exactly 32 bytes.
EMAIL_ENCRYPTION_KEY=
EMAIL_WORKER_SECRET=
# Optional challenge TTL, constrained to 5–30 minutes
AUTH_CHALLENGE_TTL_MINUTES=15
